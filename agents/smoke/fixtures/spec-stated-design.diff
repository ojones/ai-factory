diff --git a/backend/src/routes/items.ts b/backend/src/routes/items.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/routes/items.ts
@@ -0,0 +1,14 @@
+import { Router } from "express";
+import { isFeatureEnabled } from "../feature-flags";
+
+// In-memory store; lost on restart.
+export const items: { id: string; title: string }[] = [];
+
+export const itemsRouter = Router();
+
+itemsRouter.get("/api/items", async (_req, res) => {
+  if (!(await isFeatureEnabled(res, "items-list"))) {
+    res.status(404).json({ error: "not found" });
+    return;
+  }
+  res.json(items);
+});
