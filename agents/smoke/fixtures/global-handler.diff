diff --git a/backend/src/app.ts b/backend/src/app.ts
--- a/backend/src/app.ts
+++ b/backend/src/app.ts
@@ -5,2 +5,10 @@ import { pingRouter } from "./routes/ping";
 app.use(pingRouter);
+
+// Return 400 instead of the default 500 for malformed JSON on every route.
+app.use((err: any, _req: any, res: any, next: any) => {
+  if (err instanceof SyntaxError) {
+    res.status(400).json({ error: "invalid JSON" });
+    return;
+  }
+  next(err);
+});
diff --git a/backend/src/routes/ping.ts b/backend/src/routes/ping.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/routes/ping.ts
@@ -0,0 +1,10 @@
+import { Router } from "express";
+import { isFeatureEnabled } from "../feature-flags";
+
+export const pingRouter = Router();
+
+pingRouter.get("/api/ping", async (_req, res) => {
+  if (!(await isFeatureEnabled(res, "ping"))) { res.status(404).json({ error: "not found" }); return; }
+  res.json({ pong: true });
+});
