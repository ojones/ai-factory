diff --git a/backend/src/routes/heartbeat.ts b/backend/src/routes/heartbeat.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/routes/heartbeat.ts
@@ -0,0 +1,20 @@
+import { Router } from "express";
+import { getFeatureFlagClient, featureKey } from "../feature-flags";
+import { logger } from "../logger";
+
+export const heartbeatRouter = Router();
+
+heartbeatRouter.get("/api/heartbeat/fast", async (req, res) => {
+  const enabled = await getFeatureFlagClient().getBooleanValue(
+    featureKey("fast-heartbeat"),
+    false
+  );
+  if (!enabled) {
+    res.status(404).json({ error: "not found" });
+    return;
+  }
+  
+  // This would generate error logs in normal operation
+  logger.error("Intentional error for testing");
+  res.json({ status: "ok" });
+});
