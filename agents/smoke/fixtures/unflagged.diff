diff --git a/backend/src/routes/export.ts b/backend/src/routes/export.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/routes/export.ts
@@ -0,0 +1,12 @@
+import { Router } from "express";
+import { items } from "./items";
+
+export const exportRouter = Router();
+
+// Lets users download all their items as CSV.
+exportRouter.get("/api/export", (_req, res) => {
+  const rows = items.map((i) => `${i.id},${i.title}`).join("\n");
+  res.type("text/csv").send(`id,title\n${rows}`);
+});
