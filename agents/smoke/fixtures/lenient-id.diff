diff --git a/backend/src/routes/items.ts b/backend/src/routes/items.ts
--- a/backend/src/routes/items.ts
+++ b/backend/src/routes/items.ts
@@ -10,0 +11,14 @@ export const itemsRouter = Router();
+itemsRouter.delete("/api/items/:id", async (req, res) => {
+  if (!(await isFeatureEnabled(res, "item-delete"))) {
+    res.status(404).json({ error: "not found" });
+    return;
+  }
+  const id = parseInt(req.params.id);
+  if (isNaN(id)) {
+    res.status(400).json({ error: "invalid id" });
+    return;
+  }
+  const i = items.findIndex((x) => x.id === id);
+  if (i === -1) { res.status(404).json({ error: "not found" }); return; }
+  items.splice(i, 1);
+  res.status(204).send();
+});
