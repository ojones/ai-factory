diff --git a/backend/src/routes/search.ts b/backend/src/routes/search.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/routes/search.ts
@@ -0,0 +1,16 @@
+import { Router } from "express";
+import { isFeatureEnabled } from "../feature-flags";
+import { items } from "./items";
+
+export const searchRouter = Router();
+
+searchRouter.get("/api/search", async (req, res) => {
+  if (!(await isFeatureEnabled(res, "search"))) {
+    res.status(404).json({ error: "not found" });
+    return;
+  }
+  const q = String(req.query.q ?? "").toLowerCase();
+  res.json(items.filter((i) => i.title.toLowerCase().includes(q)));
+});
diff --git a/backend/src/__tests__/search.test.ts b/backend/src/__tests__/search.test.ts
new file mode 100644
--- /dev/null
+++ b/backend/src/__tests__/search.test.ts
@@ -0,0 +1,18 @@
+import request from "supertest";
+import { createApp } from "../app";
+import { withFlag } from "./with-flag";
+
+describe("GET /api/search", () => {
+  it("answers 404 while the flag is off", async () => {
+    await withFlag("search", false, async () => {
+      const res = await request(createApp()).get("/api/search?q=a");
+      expect(res.status).toBe(404);
+    });
+  });
+  it("filters items by title while the flag is on", async () => {
+    await withFlag("search", true, async () => {
+      const res = await request(createApp()).get("/api/search?q=zzz");
+      expect(res.body).toEqual([]);
+    });
+  });
+});
