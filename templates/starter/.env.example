# Copy to .env for local development. Real values in deployed environments
# are injected by the deploy pipeline's secrets flow — never commit a .env
# with real values (STANDARDS-CODING.md: env vars only, zero hardcoded
# config/secrets).

# Port the backend HTTP server listens on.
PORT=3000

# Optional override for where the backend looks for the built frontend's
# static assets. Defaults to ../../frontend/dist relative to the compiled
# backend entrypoint, which is correct for both local builds and the
# Docker image's layout — only set this if you've moved things around.
# FRONTEND_DIST_PATH=
