# Copy to .env for local development. Real values in deployed environments
# are injected by the deploy pipeline's secrets flow — never commit a .env
# with real values (STANDARDS-CODING.md: env vars only, zero hardcoded
# config/secrets).

# Port the backend HTTP server listens on.
PORT=3000

# Optional override for where the backend looks for the built frontend's
# static assets. Defaults to ../../frontend/dist relative to the compiled
# backend entrypoint, which is correct for both local builds and the
# Docker image's layout — only set this if you've moved things around.
# FRONTEND_DIST_PATH=

# Feature flags (STANDARDS-FEATURE-FLAGS.md). The Orchestrator provisions
# this per Built Application and pushes it as a repo secret — required,
# no default.
GROWTHBOOK_CLIENT_KEY=

# Optional override for the shared GrowthBook instance's API host. Defaults
# to the Factory's one shared instance (ARCHITECTURE.md) — only set this
# for local testing against a different instance.
# GROWTHBOOK_API_HOST=

# Scopes flag keys by app (<app-slug>.feature.<slug>). Fly sets FLY_APP_NAME
# itself in deployed environments; set this only for local runs.
# APP_SLUG=

# Secret that lets a request see features still dark behind their flag
# (STANDARDS-FEATURE-FLAGS.md#preview). Pushed by the Orchestrator; leave
# unset locally to disable preview.
# PREVIEW_TOKEN=
